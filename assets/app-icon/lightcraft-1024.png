<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Card Background Gradient -->
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#32353c" />
      <stop offset="100%" stop-color="#1e2025" />
    </linearGradient>

    <!-- Outer Rim Metallic Gradient -->
    <linearGradient id="metalRim" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e6e8eb" />
      <stop offset="50%" stop-color="#8a909a" />
      <stop offset="100%" stop-color="#4a4d55" />
    </linearGradient>

    <!-- Aperture Ring Gradient -->
    <linearGradient id="apertureRing" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4f535d" />
      <stop offset="100%" stop-color="#212328" />
    </linearGradient>

    <!-- Glowing Lens Center Gradient (Warm Amber Glow) -->
    <radialGradient id="lensGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffea9f" />
      <stop offset="45%" stop-color="#ffaa00" />
      <stop offset="85%" stop-color="#e66800" />
      <stop offset="100%" stop-color="#8a3000" />
    </radialGradient>

    <!-- Glass Reflection Highlight -->
    <linearGradient id="glassReflect" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.6" />
      <stop offset="40%" stop-color="#ffffff" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>

    <!-- Light Beams Gradients -->
    <linearGradient id="redBeam" x1="0%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" stop-color="#ff3b30" />
      <stop offset="100%" stop-color="#ff9500" stop-opacity="0.2" />
    </linearGradient>

    <linearGradient id="yellowBeam" x1="50%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" stop-color="#ffcc00" />
      <stop offset="100%" stop-color="#ffcc00" stop-opacity="0.2" />
    </linearGradient>

    <linearGradient id="blueBeam" x1="100%" y1="100%" x2="50%" y2="0%">
      <stop offset="0%" stop-color="#007aff" />
      <stop offset="100%" stop-color="#5856d6" stop-opacity="0.2" />
    </linearGradient>

    <!-- Shadow for Depth -->
    <filter id="dropShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Outer Rounded Square App Container -->
  <rect x="32" y="32" width="448" height="448" rx="104" fill="url(#cardBg)" stroke="url(#metalRim)" stroke-width="6" filter="url(#dropShadow)" />

  <!-- Inner Bezel Ring -->
  <rect x="44" y="44" width="424" height="424" rx="92" fill="none" stroke="#ffffff" stroke-opacity="0.08" stroke-width="2" />

  <!-- Dynamic Spectrum Light Rays (Bottom Wave Effect) -->
  <g opacity="0.9">
    <path d="M 120 440 C 180 400 210 320 256 280 C 240 360 200 420 160 440 Z" fill="url(#redBeam)" />
    <path d="M 210 440 C 236 380 248 330 256 280 C 264 330 276 380 302 440 Z" fill="url(#yellowBeam)" />
    <path d="M 392 440 C 332 400 302 320 256 280 C 272 360 312 420 352 440 Z" fill="url(#blueBeam)" />
  </g>

  <!-- Main Camera Outer Housing Circle -->
  <circle cx="256" cy="256" r="140" fill="url(#apertureRing)" stroke="url(#metalRim)" stroke-width="8" filter="url(#dropShadow)" />

  <!-- Aperture Blades (Shutter Lines) -->
  <g stroke="#1a1b1e" stroke-width="3" opacity="0.7">
    <line x1="256" y1="116" x2="200" y2="180" />
    <line x1="376" y1="196" x2="300" y2="180" />
    <line x1="356" y1="336" x2="310" y2="260" />
    <line x1="216" y1="386" x2="210" y2="310" />
    <line x1="136" y1="276" x2="200" y2="250" />
  </g>

  <!-- Inner Metallic Ring around Lens -->
  <circle cx="256" cy="256" r="92" fill="none" stroke="url(#metalRim)" stroke-width="5" />

  <!-- Main Amber Glowing Lens Core -->
  <circle cx="256" cy="256" r="76" fill="url(#lensGlow)" />

  <!-- Glass Curved Reflection Flare -->
  <path d="M 200 210 A 70 70 0 0 1 312 210 A 68 68 0 0 0 200 210 Z" fill="url(#glassReflect)" />
  <circle cx="290" cy="220" r="8" fill="#ffffff" opacity="0.7" />
</svg>
